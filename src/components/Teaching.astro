---
import type { Lang, SiteContent } from '../i18n/types';
import { SECTION_IDS, SECTION_INDEX } from '../i18n/utils';
import { revealDelay } from '../lib/format';
import Videos from './Videos.astro';

interface Props {
  lang: Lang;
  teaching: SiteContent['teaching'];
}

const { lang, teaching } = Astro.props;

/**
 * La mono es la voz del dato y DESIGN §3.2 le pone un techo de tres palabras.
 * Cuatro de los cinco periodos son rangos de fecha; uno es prosa («Durante la
 * etapa en Talentus» / «During my time at Talentus»). Ese se compone en Inter:
 * en mono rompería el techo y, peor, se leería como un dato verificable.
 */
function isDatePeriod(period: string): boolean {
  const words = period.split(/[^\p{L}]+/u).filter(Boolean);
  return /\d{4}/.test(period) && words.length <= 3;
}

/**
 * UN SOLO PÁRRAFO, y es el ÚLTIMO.
 *
 * El diccionario trae dos. El primero enumera en prosa exactamente lo mismo que
 * la lista de abajo —los talleres, la coordinación, las oposiciones, los cursos
 * de empresa— y leerlo dos veces seguidas es lo que hacía abrumadora esta
 * sección. El segundo es el único que aporta algo que la lista no puede decir:
 * POR QUÉ la docencia está en un currículum de ingeniería.
 *
 * Se toma por el final y no por índice para que siga funcionando si el
 * diccionario gana o pierde un párrafo. Nada se borra de `es.ts` ni de `en.ts`:
 * los dos párrafos siguen alimentando el CV en PDF.
 */
const argument = teaching.paragraphs.at(-1) ?? null;
---

<!-- 05 · Docencia. Junto con Formación, la parte menos importante de la página,
     y la maqueta lo dice: las dos comparten banda `--surface`, ancho, retícula
     y anatomía de fila. Se leen como UN registro partido en dos capítulos, no
     como dos secciones más de puestos.
     La compresión es de contenido, no de tipografía: fuera un párrafo entero
     (el que repetía la lista) y las filas pasan de bloque de cuatro líneas a
     ficha de tres dentro de una placa. -->
<section
  class="section section-surface"
  id={SECTION_IDS.teaching}
  aria-labelledby="teaching-title"
>
  <div class="shell">
    <!-- Alineado a la IZQUIERDA del shell, no centrado: DESIGN §6.6 pedía
         centrar y a 1440 eso dejaba 312 px muertos a la izquierda y rompía la
         vertical que comparten las otras cinco secciones.
         La cabecera se queda en su medida de prosa (68ch) y la placa se va a
         `max-w-content`, que es el ancho de contenido de Perfil, Experiencia y
         Stack: intro estrecha, registro ancho. A 640 px la fila se partía en
         cuatro renglones y la pareja de vídeos del TFG quedaba en dos tarjetas
         de 180 px; a 960 cada ficha cabe en tres líneas. Más ancho es aquí
         MENOS alto, que es de lo que iba la compresión.
         `mb-8` en vez de los 48 px de `.section-head`: sin un muro de prosa
         detrás, 48 px dejaban la cabecera flotando lejos de su contenido. -->
    <header class="section-head mb-8" data-reveal>
      <p class="section-kicker">
        <span><span data-num>{SECTION_INDEX.teaching}</span> · {teaching.title}</span>
      </p>
      <h2 class="section-title" id="teaching-title">{teaching.title}</h2>
      <p class="section-lead">{teaching.lead}</p>
    </header>

    {
      argument && (
        <p
          class="max-w-prose border-l-2 border-border-strong pl-5 text-base text-text-2"
          data-reveal
          data-reveal-delay="45"
        >
          {argument}
        </p>
      )
    }

    {/*
      Lista de definición, no tarjetas: el periodo es el término y el puesto su
      definición. Sin encabezados a propósito — la docencia se lee como registro
      subordinado a Experiencia, no como una segunda sección de puestos.

      La placa —fondo `--bg` rehundido sobre la banda `--surface`, filete de
      1 px y radio 12— es el bloque que Formación repite clase por clase. Es
      todo lo que hace falta para que las dos secciones se lean como una sola
      pieza: cero sombras y ni un color nuevo.
    */}
    <dl class="mt-8 max-w-content overflow-hidden rounded-lg border border-border bg-bg">
      {
        teaching.items.map((item, index) => (
          <div
            class="grid gap-y-1 border-t border-border p-5 first:border-t-0 md:grid-cols-[var(--col-period)_minmax(0,1fr)] md:gap-x-6"
            data-reveal
            data-reveal-delay={revealDelay(index)}
          >
            {/* `pt-0.5` corrige ópticamente el desfase de línea base entre el
                periodo (13 px) y el cargo (16 px) cuando van en columnas.
                El ancho de la columna sale de `--col-period`, el token que el
                sistema define una vez para las cuatro listas con fecha. */}
            {isDatePeriod(item.period) ? (
              <dt class="font-mono text-xs text-text-3 md:pt-0.5" data-num>
                {item.period}
              </dt>
            ) : (
              <dt class="text-sm text-text-3 md:pt-0.5">{item.period}</dt>
            )}

            <dd>
              <p class="text-base font-medium text-text">{item.role}</p>
              <p class="mt-0.5 text-sm text-text-2">{item.org}</p>
              <p class="mt-2 max-w-[68ch] text-sm text-text-3">{item.description}</p>

              {/* Ciberlandia es la única línea de esta lista con prueba en
                  vídeo, y el vídeo va justo debajo de la afirmación que
                  demuestra. Sin miniatura, la fila sigue leyéndose igual. */}
              {item.videos && item.videos.length > 0 && (
                <Videos lang={lang} videos={item.videos} />
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
