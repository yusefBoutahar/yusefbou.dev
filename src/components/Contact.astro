---
import type { Lang, SiteContent } from '../i18n/types';
import { SECTION_IDS, SECTION_INDEX, SITE, cvPath } from '../i18n/utils';
import Icon from './Icon.astro';
import type { IconName } from './icons';

interface Props {
  lang: Lang;
  contact: SiteContent['contact'];
  /** Microcopia del botón de copiar; sale de `useUi(lang)`, no del componente. */
  copyLabel: string;
  copiedLabel: string;
  copyAriaLabel: string;
}

const { lang, contact, copyLabel, copiedLabel, copyAriaLabel } = Astro.props;

// El correo se escribe una vez y se reutiliza en la tarjeta de comando, en el
// botón secundario y en el atributo que lee el script de copiado.
const mailto = `mailto:${contact.email}`;

// Tres perfiles como baldosas. El canal de YouTube entra el último: es prueba,
// no credencial de contacto. La marca SUSTITUYE a la flecha ↗ —regla del sitio,
// igual que en el hero y en el pie—: el logotipo ya dice que el destino es
// externo y dos glifos en un enlace de una palabra son un árbol de navidad.
const profiles: { href: string; label: string; icon: IconName }[] = [
  { href: SITE.linkedin, label: contact.linkedinLabel, icon: 'linkedin' },
  { href: SITE.github, label: contact.githubLabel, icon: 'github' },
  { href: SITE.youtube, label: contact.youtubeLabel, icon: 'youtube' },
];
---

<!-- 07 · Contacto. LA SEGUNDA LOSA OSCURA DEL SITIO, y la última impresión.
     El hero abre con una placa oscura sobre el papel crema y el contacto cierra
     con otra: la página empieza y termina en el mismo material, y en medio todo
     es cuaderno. Aquí la losa es además el «Dark Gradient Hero Banner» —el
     ÚNICO degradado que el sistema permite, y solo como fondo de sección—.
     `.on-dark` redeclara la capa cruda de tokens para todo el subárbol: los
     botones, el filete del cintillo, la tarjeta de comando y las baldosas se
     recalculan solos, sin una sola regla duplicada y sin un hexadecimal.
     Dos columnas a partir de 900 px: a la izquierda lo que se lee una vez —el
     titular, la frase y la nota—; a la derecha lo que se USA —la dirección, las
     dos acciones y los tres perfiles—. -->
<section
  class="section contact-band on-dark band-dark"
  id={SECTION_IDS.contact}
  aria-labelledby="contact-title"
>
  <div class="shell contact-grid">
    <div>
      <header class="section-head mb-8" data-reveal>
        <p class="section-kicker">
          <span><span data-num>{SECTION_INDEX.contact}</span> · {contact.title}</span>
        </p>
        <h2 class="section-title" id="contact-title">{contact.title}</h2>
        <p class="section-lead">{contact.lead}</p>
      </header>

      <p class="max-w-[56ch] text-sm text-text-3" data-reveal data-reveal-delay="45">
        {contact.note}
      </p>
    </div>

    <div class="contact-panel">
      <!-- LA DIRECCIÓN, COMO TARJETA DE COMANDO. Es la pieza gráfica de la
           sección: `$` de indicativo, la dirección en mono y el botón de copiar
           dentro de la misma placa. La lógica es la de siempre y no se ha
           tocado ni una línea: el botón NACE OCULTO y solo lo destapa el script
           si hay portapapeles, la confirmación la canta una región viva, y sin
           JavaScript la dirección sigue siendo un `mailto:` que funciona. Lo
           único que ha cambiado es la piel. -->
      <div
        class="contact-copy"
        data-reveal
        data-copy-root
        data-copy-email={contact.email}
        data-copy-done={copiedLabel}
      >
        <span class="snippet contact-snippet">
          {/* Indicativo de terminal: es cromo, no contenido. Un lector de
              pantalla que lea «dólar» antes de la dirección estorba. */}
          <span class="snippet-prompt" aria-hidden="true">$</span>
          <a class="link contact-mail" href={mailto}>{contact.email}</a>

          {/* Los dos iconos viajan en el marcado y solo se turnan con una
              clase: miden lo mismo (16), así que el botón no cambia de ancho
              al confirmar y no hay ni un pixel de desplazamiento. El nombre
              accesible lo sigue dando `aria-label`, que no cambia; quien
              anuncia el éxito es la región viva de al lado, no el icono. */}
          <button
            type="button"
            class="hidden btn btn-ghost contact-copy-btn font-mono text-xs"
            aria-label={copyAriaLabel}
            data-copy-button
          >
            <span aria-hidden="true">[{copyLabel}]</span>
            <span data-copy-icon="idle"><Icon name="copy" size={16} /></span>
            <span class="hidden" data-copy-icon="done"><Icon name="check" size={16} /></span>
          </button>
        </span>

        <!-- Confirmación textual, sin animación y sin depender del color. -->
        <span class="label" role="status" aria-live="polite" data-copy-status></span>
      </div>

      <!-- Las dos acciones de verdad. Sobre oscuro el primario se invierte a
           relleno claro («Filled Light CTA»), que es el mayor contraste
           disponible ahí, y lo hace `.on-dark` sin que este fichero lo pida. -->
      <div class="contact-actions" data-reveal data-reveal-delay="45">
        <a class="btn btn-primary" href={cvPath(lang)} download>
          {contact.cvLabel}<Icon name="download" size={16} />
        </a>
        <a class="btn btn-secondary" href={mailto}>
          {contact.emailLabel}<Icon name="mail" size={16} />
        </a>
      </div>

      <div data-reveal data-reveal-delay="90">
        {/* El rótulo no es decoración: da nombre accesible a la lista de
            baldosas, que si no se anuncia como «lista de tres elementos». */}
        <p class="label" id="contact-profiles">{contact.profilesLabel}</p>

        <ul class="contact-tiles" role="list" aria-labelledby="contact-profiles">
          {
            profiles.map((profile) => (
              <li>
                <a class="contact-tile" href={profile.href} target="_blank" rel="noopener">
                  <Icon name={profile.icon} size={20} />
                  <span>{profile.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  /* LA LOSA. Misma mecánica que `.hero`, clase por clase: la sección se
     estrecha al ancho del shell, mete el gutter POR DENTRO y deja el borde de
     la placa fuera, sobre el crema. Así el contenido cae exactamente sobre la
     misma vertical que el de las secciones de arriba y el degradado no llega a
     sangre. El radio (16) y el `border: 0` los pone ya `.band-dark`. */
  .contact-band {
    inline-size: calc(100% - var(--gutter) * 2);
    max-inline-size: var(--container-shell);
    margin-inline: auto;
    margin-block: var(--gutter);
    padding-inline: var(--gutter);
  }
  .contact-band > .shell {
    padding-inline: 0;
    max-inline-size: none;
  }

  .contact-grid {
    display: grid;
    gap: 2.5rem;
  }
  /* 900 px es el mismo umbral de una columna que usa el hero. */
  @media (min-width: 900px) {
    .contact-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 27rem);
      gap: 4rem;
      align-items: start;
    }
  }

  .contact-panel {
    display: grid;
    gap: 1.5rem;
  }

  /* La tarjeta de comando y su confirmación. Envuelven porque en móvil
     «COPIADO» no cabe al lado de la dirección. */
  .contact-copy {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  /* `.snippet` del sistema con tres ajustes y ninguno inventado:
     · el relleno vertical baja a 4 px porque el botón de copiar va DENTRO y
       conserva sus 44 px de objetivo táctil — se le quita aire a la tarjeta,
       nunca altura al control;
     · la dirección sube a 16 px: es lo único que hay que leer aquí;
     · `min-inline-size: 0` deja que la tarjeta encoja dentro del flex y que su
       propio `overflow-x` haga el trabajo en pantallas estrechas. */
  .contact-snippet {
    gap: 0.5rem;
    padding-block: 0.25rem;
    padding-inline: 0.875rem 0.3125rem;
    font-size: var(--text-base);
    min-inline-size: 0;
  }
  /* SIN JAVASCRIPT el botón sigue con su `hidden` puesto y no ocupa nada: si la
     tarjeta se quedara con los 5 px de relleno que le hacen sitio, la dirección
     acabaría pegada al filete. Se le devuelven los 14 px. Un navegador sin
     `:has()` ve la variante estrecha, que es cosmética. */
  .contact-snippet:has(> .hidden) {
    padding-inline-end: 0.875rem;
  }
  /* La dirección no se parte nunca: si no cabe, la tarjeta se desplaza. */
  .contact-mail {
    white-space: nowrap;
    font-weight: 500;
  }
  .contact-copy-btn {
    flex: none;
    min-inline-size: 0;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* Baldosas de perfil: icono arriba, marca debajo. `auto-fit` con un mínimo de
     96 px —lo que mide «LinkedIn» en mono más su relleno— las deja en tres
     hasta un móvil de 360 px y en dos por debajo, sin un solo punto de ruptura
     escrito a mano. */
  .contact-tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(6rem, 1fr));
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  /* Fondo TRANSPARENTE a propósito: una superficie opaca aquí taparía el
     degradado con un rectángulo gris. Filete de 1 px y nada más — cero
     sombras, cero desplazamiento al pasar por encima: lo único que cambia es
     el filete y el color del texto, como en `.card`. */
  .contact-tile {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    min-block-size: 2.75rem;
    padding: 0.875rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--text-xs--letter-spacing);
    color: var(--color-text-2);
    text-decoration: none;
    transition:
      border-color var(--dur-micro) var(--ease-out-quint),
      color        var(--dur-micro) var(--ease-out-quint);
  }
  @media (hover: hover) and (pointer: fine) {
    .contact-tile:hover {
      border-color: var(--color-border-ui);
      color: var(--color-text);
    }
  }
  .contact-tile:focus-within {
    border-color: var(--color-border-ui);
  }
</style>

<script>
  // Copiar el correo. Progresivo de verdad: el botón está oculto en el HTML y
  // solo se destapa si existe la API de portapapeles (contexto seguro). Si algo
  // falla no se anuncia nada: una confirmación falsa es peor que ninguna.
  const root = document.querySelector<HTMLElement>('[data-copy-root]');
  const button = root?.querySelector<HTMLButtonElement>('[data-copy-button]');
  const status = root?.querySelector<HTMLElement>('[data-copy-status]');
  // Los dos iconos del botón: el de copiar y el de confirmación. Se turnan con
  // la misma clase `hidden` que ya destapa el botón; si no estuvieran (por lo
  // que sea) el copiado sigue funcionando igual, solo sin cambio de icono.
  const iconIdle = button?.querySelector<HTMLElement>('[data-copy-icon="idle"]');
  const iconDone = button?.querySelector<HTMLElement>('[data-copy-icon="done"]');
  const email = root?.dataset.copyEmail ?? '';
  const doneLabel = root?.dataset.copyDone ?? '';

  if (button && status && email && navigator.clipboard) {
    button.classList.remove('hidden');

    let timer = 0;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(email);
      } catch {
        return;
      }
      // Se vacía y se vuelve a escribir para que la región en vivo anuncie
      // también las repeticiones seguidas.
      status.textContent = '';
      status.textContent = doneLabel;
      iconIdle?.classList.add('hidden');
      iconDone?.classList.remove('hidden');
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        status.textContent = '';
        iconDone?.classList.add('hidden');
        iconIdle?.classList.remove('hidden');
      }, 2400);
    });
  }
</script>
