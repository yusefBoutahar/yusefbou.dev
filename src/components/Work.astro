---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

import type { Lang, SiteContent } from '../i18n/types';
import { SECTION_IDS, SECTION_INDEX } from '../i18n/utils';
import { revealDelay, splitVersion } from '../lib/format';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  work: SiteContent['work'];
  /** Capturas 1440×900 indexadas por `SiteProject.shot` (`qahwa`, …). */
  shots: Record<string, ImageMetadata>;
}

const { work, shots } = Astro.props;

/** Chips visibles por tarjeta (DESIGN §6.4). El resto se resume en `+N`. */
const MAX_CHIPS = 6;

/**
 * Anclas profundas. Los cinco `id` de caso y los tres de sitio son direcciones
 * públicas: se citan desde LinkedIn y desde el CV, así que un `id` duplicado o
 * que choque con una sección no es un detalle estético, es un enlace roto que
 * nadie ve romperse. Se comprueba en construcción y la build se cae.
 */
const siteAnchorId = (shot: string) => `work-site-${shot}`;

const anchorIds = [
  ...work.caseStudies.map((study) => study.id),
  ...work.sites.map((site) => siteAnchorId(site.shot)),
];
const reservedIds = new Set<string>(Object.values(SECTION_IDS));
const seenIds = new Set<string>();

for (const id of anchorIds) {
  if (!/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(id)) {
    throw new Error(`Work.astro: el ancla "${id}" no es un identificador de URL válido.`);
  }
  if (reservedIds.has(id)) {
    throw new Error(`Work.astro: el ancla "${id}" choca con un id de sección de SECTION_IDS.`);
  }
  if (seenIds.has(id)) {
    throw new Error(`Work.astro: el ancla "${id}" está duplicada en el diccionario.`);
  }
  seenIds.add(id);
}

/**
 * El dominio que va en la barra de la tarjeta de navegador. Sale de la MISMA
 * URL a la que enlaza la tarjeta, no de una cadena escrita a mano en el
 * diccionario: así la barra no puede mentir sobre el destino del enlace.
 */
const domainOf = (url: string) => new URL(url).hostname.replace(/^www\./, '');
---

<section class="section" id={SECTION_IDS.work} aria-labelledby="work-title">
  <div class="shell">
    <header class="section-head" data-reveal>
      <p class="section-kicker">
        <span><span data-num>{SECTION_INDEX.work}</span> · {work.title}</span>
      </p>
      <h2 class="section-title" id="work-title">{work.title}</h2>
      <p class="section-lead">{work.lead}</p>
    </header>

    <!-- El NDA se declara UNA vez y arriba: repetido en cada tarjeta parecería
         una excusa; una sola vez, profesionalidad. -->
    <p class="work-note measure text-sm text-text-3" data-reveal>{work.confidentialityNote}</p>

    <ol class="case-grid max-w-wide">
      {
        work.caseStudies.map((study, i) => {
          const chips = study.tech.slice(0, MAX_CHIPS).map(splitVersion);
          const extra = study.tech.slice(MAX_CHIPS);

          return (
            <li
              class:list={['case-cell', i === 0 && 'case-cell-wide']}
              id={study.id}
              data-reveal
              data-reveal-delay={revealDelay(i)}
            >
              <article class:list={['card', 'case-card', i === 0 && 'card-current']}>
                <p class="case-kicker label">
                  <span class="case-num" data-num>{String(i + 1).padStart(2, '0')}</span> · {study.kicker}
                </p>
                <h3 class:list={['case-title', i === 0 ? 'text-3xl' : 'text-2xl']}>{study.title}</h3>

                {/* La tarjeta enseña el GANCHO y las pruebas, nada más. El trío
                    PROBLEMA/ENFOQUE/RESULTADO sigue entero, pero de los tres
                    solo el resultado se lee sin pedirlo: es el único que
                    responde «¿y qué pasó?», que es lo que trae a quien lee.
                    Los otros dos son el desarrollo y se pliegan abajo. */}
                <div class="case-body">
                  <p class="case-hook">
                    <span class="label case-hook-label">{work.resultLabel}</span>
                    <span class="case-hook-text">{study.result}</span>
                  </p>

                  <div class="case-aside">
                    {study.metrics && study.metrics.length > 0 && (
                      <dl class="stat-band case-stats">
                        {study.metrics.map((metric) => (
                          <div class="stat">
                            <dt class="stat-label">{metric.label}</dt>
                            <dd class="stat-value">{metric.value}</dd>
                          </div>
                        ))}
                      </dl>
                    )}

                    <ul class="chip-list">
                      {chips.map(({ name, version }) => (
                        <li class="chip">
                          {name}
                          {version && <span class="chip-version">{version}</span>}
                        </li>
                      ))}
                      {extra.length > 0 && (
                        <li class="chip chip-more" title={extra.join(' · ')} aria-label={extra.join(', ')}>
                          +{extra.length}
                        </li>
                      )}
                    </ul>
                  </div>
                </div>

                {/* `<details>` nativo, la pieza del sistema: sin JavaScript, con
                    estado del navegador y accesible de serie. Sin JS la página
                    se ve entera y el plegado se abre igual. */}
                <details class="disclosure">
                  <summary class="disclosure-summary">{work.detailLabel}</summary>
                  <div class="disclosure-body">
                    <dl class="case-trio">
                      <div class="case-row">
                        <dt class="label">{work.problemLabel}</dt>
                        <dd class="measure text-sm text-text-2">{study.problem}</dd>
                      </div>
                      <div class="case-row">
                        <dt class="label">{work.approachLabel}</dt>
                        <dd class="measure text-sm text-text-2">{study.approach}</dd>
                      </div>
                    </dl>
                  </div>
                </details>
              </article>
            </li>
          );
        })
      }
    </ol>

    <div class="sites">
      <header class="sites-head measure" data-reveal>
        <h3 class="sites-title text-2xl" id="work-sites-title">{work.sitesTitle}</h3>
        <p class="sites-lead text-base text-text-2">{work.sitesLead}</p>
      </header>

      <ul class="site-list max-w-wide" aria-labelledby="work-sites-title">
        {
          work.sites.map((site, i) => {
            const shot = shots[site.shot];
            const id = siteAnchorId(site.shot);

            return (
              <li class="site-row" id={id} data-reveal data-reveal-delay={revealDelay(i)}>
                {/* Toda la tarjeta enlaza al sitio VIVO, nunca al repositorio.
                    El nombre accesible sale del título más la acción, los dos
                    del diccionario; el resto del contenido sigue leyéndose. */}
                <a
                  class="site-card"
                  href={site.url}
                  target="_blank"
                  rel="noopener"
                  aria-labelledby={`${id}-name ${id}-visit`}
                >
                  {/* «Dashboard Preview Card» del sistema. La captura es lo más
                      grande de la sección a propósito: enseña el trabajo en vez
                      de describirlo, y el dominio en mono dentro de la barra
                      dice a dónde va el enlace sin gastar una línea de texto. */}
                  <div class="browser-card">
                    <div class="browser-bar">
                      <span class="browser-dots" aria-hidden="true"><i /><i /><i /></span>
                      <span class="browser-url">{domainOf(site.url)}</span>
                      <span class="browser-visit" id={`${id}-visit`}>
                        {work.visitLabel}<Icon name="external-link" size={14} />
                      </span>
                    </div>
                    <div class="browser-frame" data-shot-frame>
                      {shot && (
                        <Picture
                          class="browser-shot"
                          src={shot}
                          alt={site.shotAlt}
                          formats={['avif', 'webp']}
                          fallbackFormat="jpeg"
                          width={960}
                          height={600}
                          widths={[360, 540, 720, 1080, 1440]}
                          sizes="(min-width: 1200px) 640px, (min-width: 900px) 55vw, calc(100vw - 2rem)"
                          loading="lazy"
                          decoding="async"
                        />
                      )}
                    </div>
                  </div>

                  <div class="site-info">
                    <h4 class="site-name" id={`${id}-name`}>
                      {site.name}<span class="site-arrow"><Icon name="arrow-up-right" size={18} /></span>
                    </h4>
                    <p class="site-desc text-sm text-text-2">{site.description}</p>

                    <dl class="stat-band site-stats">
                      {site.metrics.map((metric) => (
                        <div class="stat">
                          <dt class="stat-label">{metric.label}</dt>
                          <dd class="stat-value">{metric.value}</dd>
                        </div>
                      ))}
                    </dl>

                    <ul class="chip-list">
                      {site.tech.slice(0, MAX_CHIPS).map(splitVersion).map(({ name, version }) => (
                        <li class="chip">
                          {name}
                          {version && <span class="chip-version">{version}</span>}
                        </li>
                      ))}
                    </ul>
                  </div>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</section>

<script>
  /**
   * El esqueleto de carga SOLO existe si hay JS. Si la clase estuviera en el
   * marcado, sin JS el brillo taparía la captura para siempre: la regla de
   * robustez de DESIGN §7 se aplica también aquí, invertida.
   */
  for (const frame of document.querySelectorAll<HTMLElement>('[data-shot-frame]')) {
    const img = frame.querySelector('img');
    if (!img || img.complete) continue;
    frame.classList.add('sk-wrap');
    const done = () => frame.classList.add('sk-done');
    img.addEventListener('load', done, { once: true });
    img.addEventListener('error', done, { once: true });
  }
</script>

<style>
  /* Maqueta propia de la sección 03. Todo sale de tokens: aquí no hay ni un
     hex, ni una familia literal, ni un tamaño fuera de la escala. Los patrones
     repetidos del sitio (.card, .chip, .stat-*, .label, .disclosure-*,
     .browser-*) siguen viniendo de global.css; esto es solo la retícula. */

  .work-note {
    border-top: 1px solid var(--color-border);
    padding-top: 1rem;
  }

  /* --- Casos de estudio -------------------------------------------------- */

  .case-grid {
    display: grid;
    gap: 1.5rem;
    margin-top: 2rem;
  }
  /* Dos columnas a partir de 900 px: por debajo, la tarjeta no llega a las
     45ch mínimas de medida. */
  @media (min-width: 900px) {
    .case-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    /* El primer caso ocupa las dos columnas, así que un número PAR de tarjetas
       deja la última sola en su fila. Se expande para cerrar el bloque en vez
       de quedar coja. Con número impar la rejilla ya cierra sola. */
    .case-grid > li:last-child:nth-child(even) { grid-column: 1 / -1; }
  }
  /* La animación de entrada vive en la celda, no en la tarjeta: `.is-in` fija
     `transform: none` fuera de capa y le comería el hover a `.card`. */
  .case-grid > li,
  .site-list > li { display: grid; }
  .case-cell-wide { grid-column: 1 / -1; }

  /* Cada tarjeta es destino de enlace profundo (`…/#sso-oidc`, citado desde
     fuera del sitio). `html` ya lleva `scroll-padding-top` con la altura de la
     cabecera pegada, y el destino de un salto es la SUMA de ese relleno y del
     margen de scroll del elemento; este margen es, por tanto, solo la
     corrección propia de la tarjeta: los 16 px que la animación de entrada le
     resta al subirla a su sitio y que, sin esto, la dejarían pegada al borde
     inferior de la cabecera. Con movimiento reducido no hay animación y los
     16 px se leen como aire. En los dos casos el título entra entero. */
  .case-grid > li,
  .site-list > li { scroll-margin-top: 1rem; }

  /* El ancho que manda para el reparto es el de la TARJETA, no el de la
     ventana: con dos columnas la misma tarjeta es ancha o estrecha según el
     caso, y la que se expande a fila entera (la primera, y la última cuando
     queda sola) tiene que repartir gancho y pruebas en vez de dejar medio
     metro en blanco. La consulta de contenedor lo resuelve sin saber CUÁL es
     la tarjeta ancha: lo decide el ancho real. */
  .case-card {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
  }

  .case-title {
    margin-top: 0.75rem;
    font-weight: 600;
    text-wrap: pretty;
  }

  .case-num { transition: color var(--dur-micro) var(--ease-out-quint); }
  @media (hover: hover) and (pointer: fine) {
    .case-card:hover .case-num { color: var(--color-accent-fg); }
  }

  /* El margen inferior no es decorativo: en columna flexible los márgenes NO
     se colapsan, así que es el aire mínimo que el `margin-top: auto` del
     plegado no puede garantizar cuando la tarjeta va llena. */
  .case-body {
    display: grid;
    gap: 1.75rem;
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }

  /* La tarjeta pasa a caja flexible en columna para poder empujar el plegado
     al pie con `margin-top: auto`. Un ítem flexible arrastra un tamaño mínimo
     automático igual a su min-content, y aquí el cuerpo es una rejilla
     anidada: el cero corta esa cadena y deja que la franja de cifras caiga a
     una columna en el móvil en vez de estirar la tarjeta. */
  .case-body { min-inline-size: 0; }

  /* EL GANCHO. Una sola línea de lectura por tarjeta, en el color del texto
     principal: si solo se lee esto, ya se sabe qué pasó. */
  .case-hook { max-width: var(--container-prose); }
  .case-hook-label {
    display: block;
    margin-bottom: 0.375rem;
    color: var(--color-accent-fg);
  }
  .case-hook-text {
    display: block;
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--color-text-2);
    text-wrap: pretty;
  }
  /* En la tarjeta ancha el gancho es el titular de verdad y sube un escalón. */
  @container (min-width: 46rem) {
    .case-body {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: 2.5rem;
      align-items: start;
    }
    .case-hook-text { font-size: var(--text-lg); }
  }

  .case-aside {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  /* La franja canónica es de cuatro celdas sobre el fondo de página; dentro de
     una tarjeta son dos y el papel es `--surface`. Las celdas de los extremos
     pierden el relleno lateral para alinear con el texto de la tarjeta. */
  /* 11rem y no 9: a 9 caben dos celdas de 150 px en un móvil de 390 px y un
     valor como «46 MB → 4 MB» se parte por la mitad. Con 11 la rejilla cae
     sola a una columna en el móvil y sigue dando dos en la tarjeta ancha. */
  .case-stats { grid-template-columns: repeat(auto-fit, minmax(min(11rem, 100%), 1fr)); }
  .case-stats > .stat {
    background-color: var(--color-surface);
    padding: 1rem 1.25rem;
  }
  /* La celda del sistema es `flex-direction: column-reverse` con
     `justify-content: flex-end`, que ahí significa «arriba». Cuando la rama de
     `@supports (subgrid)` la convierte en rejilla, ese mismo `flex-end` deja de
     alinear el bloque y pasa a empujar la PISTA al final del eje en línea: en
     una celda más ancha que su contenido, la cifra se va a la derecha. Una
     columna explícita de `1fr` llena la pista y lo deja quieto, sin tocar el
     `justify-content` que la rama flexible sí necesita. */
  .case-stats > .stat,
  .site-stats > .stat { grid-template-columns: minmax(0, 1fr); }
  .case-stats > .stat:first-child { padding-inline-start: 0; }
  .case-stats > .stat:last-child { padding-inline-end: 0; }

  /* Las etiquetas de cifra del diccionario son frases, no micro-etiquetas: a
     dos y tres líneas, 1.2 de interlineado se cierra demasiado. */
  .case-stats .stat-label,
  .site-stats .stat-label { line-height: 1.4; }

  .chip-more { color: var(--color-text-3); }

  /* El plegado cierra la tarjeta: `margin-top: auto` lo empuja al pie para que
     dos tarjetas vecinas alineen su «VER DETALLE» aunque una tenga el título
     a dos líneas y la otra a una. */
  .case-card > .disclosure {
    margin-top: auto;
  }
  .case-trio { display: grid; gap: 1rem; }
  .case-row > dt { margin-bottom: 0.25rem; }

  /* Columna de etiquetas en cuanto la tarjeta da de sí. 6.5rem y no las 5.5rem
     del boceto: «THE APPROACH» en mono de 12 px con +0.09em mide 99 px y
     partiría la etiqueta en dos líneas. */
  @container (min-width: 30rem) {
    .case-row {
      display: grid;
      grid-template-columns: 6.5rem minmax(0, 1fr);
      column-gap: 1rem;
      align-items: start;
    }
    .case-row > dt {
      margin-bottom: 0;
      padding-top: 0.25rem;
    }
  }

  /* --- Sitios en producción ---------------------------------------------- */

  .sites { margin-top: clamp(4rem, 3rem + 4vw, 6rem); }
  .sites-title { font-weight: 600; }
  .sites-lead { margin-top: 0.75rem; }

  /* Fila entera por sitio, no tres columnas estrechas: la captura pasa de
     360 px a 640 px de ancho, que es lo que la convierte en el elemento más
     visual de la sección. Tres filas de imagen pesan menos de leer que tres
     párrafos, aunque ocupen más pantalla. */
  .site-list {
    display: grid;
    gap: clamp(2.5rem, 1.5rem + 4vw, 4rem);
    margin-top: 2rem;
  }

  .site-card {
    display: grid;
    gap: 1.5rem;
    color: var(--color-text);
    text-decoration: none;
  }
  @media (min-width: 900px) {
    .site-card {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: clamp(2rem, 1rem + 3vw, 3.5rem);
      align-items: center;
    }
    /* Alternado: la captura cambia de lado en las filas pares. Rompe la
       monotonía de tres bloques idénticos sin mover el orden del DOM, que es
       el que leen el teclado y el lector de pantalla. */
    .site-row:nth-child(even) .browser-card { order: 2; }
  }

  .site-info {
    display: grid;
    gap: 0.875rem;
    align-content: start;
  }

  .site-name {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  /* El espacio antes de la flecha lo daba un blanco dentro del texto; con un
     icono lo da el margen, en `em` para que crezca con el título. */
  .site-arrow {
    color: var(--color-accent-fg);
    margin-inline-start: 0.25em;
  }

  .site-desc { text-wrap: pretty; }

  /* La franja de cifras, apilada: las etiquetas del diccionario son frases
     largas y en una columna de 5fr dos celdas lado a lado no caben. Una
     columna conserva el filete de 1 px entre celdas, que es el objeto. */
  .site-stats {
    grid-template-columns: minmax(0, 1fr);
    margin-top: 0.25rem;
  }
  .site-stats > .stat { padding-inline: 0; }

  /* --- Tarjeta de navegador ---------------------------------------------- */

  /* El dominio se lleva el hueco libre y la acción se va al extremo: la barra
     dice a la vez QUÉ sitio es y que el enlace SALE fuera, sin esconder nada
     en un estado de hover. */
  .browser-url {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .browser-visit {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-inline-start: auto;
    padding-inline-start: 0.75rem;
    color: var(--color-accent-fg);
    white-space: nowrap;
  }

  /* Marco de captura: 16:10 exacto, que es la proporción nativa de las
     1440×900, así que `cover` no recorta nada y no hay salto de maqueta
     mientras la imagen viaja. */
  .browser-frame {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: var(--color-surface-2);
  }
  /* El <picture> lo emite `astro:assets` y no recibe el ámbito del componente. */
  .browser-frame :global(picture) {
    display: block;
    block-size: 100%;
  }
  .browser-frame :global(img.browser-shot) {
    block-size: 100%;
    object-fit: cover;
    object-position: 50% 0;
  }

  /* El filete es lo ÚNICO que se mueve al pasar por encima: el sistema prohíbe
     inventar elevación, así que no hay sombra ni desplazamiento de la tarjeta.
     El acercamiento de la captura vive dentro del marco recortado. */
  .site-card:hover .browser-card,
  .site-card:focus-visible .browser-card { border-color: var(--color-border-strong); }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .browser-frame :global(img.browser-shot) {
      transition: transform 320ms var(--ease-out-quint);
    }
    .site-card:hover .browser-frame :global(img.browser-shot) { transform: scale(1.02); }
  }
</style>
